{% extends 'base.html.twig' %}

{% block title %}Green Goodies — Mon compte{% endblock %}

{% block body %}
    <section class="account">
        <h1 class="account__title">Mon compte</h1>

        <section class="account-block account-block--orders">
            <h2 class="account-block__subtitle">Mes commandes</h2>
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Date</th>
                        <th>Prix</th>
                    </tr>
                </thead>
                <tbody>
                    {%  for order in user.orders %}
                        <tr>
                            <td>{{ order.numero }}</td>
                            <td>{{ order.createdAt | format_datetime('medium', 'none', locale: 'fr') }}</td>
                            <td>{{ order.totalPrice | format_currency('EUR', {grouping_used:false}, 'fr') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <section class="account-blocks">
            <h2 class="visually-hidden">Modifier le compte</h2>
            <div class="account-block account-block--api">
                <h3 class="account-block__subtitle">Mon accès API</h3>
                {% if user.apiAccessEnabled %}
                    <form class="account-block__form" method="post" action="{{ path("app_user_deactivate_api") }}">
                        <button class="account-block__cta" type="submit">Désactiver mon accès API</button>
                    </form>
                {% else %}
                    <form class="account-block__form" method="post" action="{{ path("app_user_activate_api") }}">
                        <button class="account-block__cta" type="submit">Activer mon accès API</button>
                    </form>
                {% endif %}
            </div>

            <div class="account-block account-block--delete">
                <form class="account-block__form" method="post" action="{{ path("app_user_delete") }}" data-confirm-message="Confirmez-vous la demande de suppression ?">
                    <button class="account-block__cta" type="submit">Supprimer mon compte</button>
                </form>
            </div>
        </section>
    </section>
{% endblock %}

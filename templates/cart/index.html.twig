{% extends 'base.html.twig' %}

{% block title %}Green Goodies — Mon panier{% endblock %}

{% block body %}
<section class="cart">
    <h1 class="cart__title">Mon panier</h1>

    <a class="cart__clear" href="#">x Vider le panier</a>

    {%  for item in cart.items %}
        <article class="cart-line">
            <div class="cart-line__image">
                <img src="{{ asset('images/products/default.png') }}" alt="">
            </div>
            <div class="cart-line__info">
                <h2 class="cart-line__title">{{ item.product.name }}</h2>
                <p class="cart-line__quantity">Quantité : {{ item.quantity }}</p>
                <p class="cart-line__price">{{ item.product.price | format_currency('EUR', {grouping_used:false}, 'fr') }}</p>
            </div>
        </article>
    {% endfor %}

    <div class="cart-summary">
        <p class="cart-summary__total">
            <span class="cart-summary__label">Total panier :</span>
            <span class="cart-summary__amount">{{ cart.getTotalPrice | format_currency('EUR', {grouping_used:false}, 'fr') }}</span>
        </p>
        <p class="cart-summary__shipping">Frais de livraison : Offert</p>
    </div>

    <form class="cart__form" method="post" action="#">
        <button class="cart__cta" type="submit">Valider la commande</button>
    </form>
</section>
{% endblock %}
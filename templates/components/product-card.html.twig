<article class="product-card">
    <div class="product-card__image">
        <img src="{{ asset('images/products/default.png') }}" alt="">
    </div>
    <div class="product-card__info">
        <header class="product-card__heading">
            <h2 class="product-card__title">{{ name }}</h2>
            <p class="product-card__tagline">{{ tagline }}</p>
        </header>
        <p class="product-card__price">{{ price }}</p>
        <button class="product-card__cta" type="button">Voir le produit</button>
    </div>
</article>

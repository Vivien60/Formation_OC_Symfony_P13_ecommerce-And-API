{% extends 'base.html.twig' %}
                                                                                                                                                                                              
  {% block title %}Green Goodies — {{ product.name }}{% endblock %}                                                                                                                             
   
  {% block body %}
      <article class="product-show">
          <div class="product-show__image">
              <img src="{{ asset('images/products/default.png') }}" alt="">
          </div>
          <div class="product-show__info">
              <h1 class="product-show__title">{{ product.name }}</h1>
              <p class="product-show__price">{{ product.price }}</p>
              <p class="product-show__description-label">Description</p>
              <p class="product-show__description">{{ product.fullDescription }}</p>
              <form class="product-show__add-to-cart" method="post" action="#">
                  <button class="product-show__cta" type="submit">Ajouter au panier</button>
              </form>
          </div>
      </article>
  {% endblock %}   